# Untrusted BSC JSON-RPC (headers + eth_getProof). Do not commit real keys.
# docker compose reads this file; the image does not contain the URL.
# Ankr free (2026-08-18): proof window ≈ 112 blocks — enough for live newest-Safe.
HELIOS_BSC_UPSTREAM=https://rpc.ankr.com/bsc/YOUR_KEY
# Optional transport failover if the primary errors (still untrusted; not a soak oracle).
# HELIOS_BSC_BACKUP=https://bsc-dataseed.binance.org

# Local verified RPC (helios-bsc run) and an independent soak oracle.
# Oracle must NOT be the same URL as HELIOS_BSC_UPSTREAM.
# HELIOS_BSC_LOCAL=http://127.0.0.1:8545
# HELIOS_BSC_ORACLE=https://bsc-mainnet.public.blastapi.io
# HELIOS_BSC_CHECKPOINT_ORACLE=https://bsc-mainnet.public.blastapi.io
